--- /dev/null
+++ b/scripts/prepare_cv_bibliographies.py
@@ -0,0 +1,24 @@
+"""Select CV sections from the single refs export; fail before writing on bad keys."""
+import json
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[1]
+records = json.loads((root / "refs/cv.json").read_text())
+by_key = {record["id"]: record for record in records}
+if len(by_key) != len(records):
+    raise ValueError("Duplicate exported key")
+sections = json.loads((root / "cv-sections.json").read_text())
+allowed = {"proceedings", "published", "forthcoming", "submission", "preparation", "other-publications", "presentations", "patents"}
+if set(sections) != allowed:
+    raise ValueError("Missing or unknown CV section")
+seen = set()
+outputs = {}
+for name, keys in sections.items():
+    if len(set(keys)) != len(keys) or seen.intersection(keys):
+        raise ValueError("Duplicate section membership")
+    seen.update(keys)
+    outputs[name] = [by_key[key] for key in keys]
+if seen != set(by_key):
+    raise ValueError("Exported record missing from section manifest")
+for name, selected in outputs.items():
+    (root / "refs" / (name + ".json")).write_text(json.dumps(selected, ensure_ascii=False, sort_keys=True, indent=2) + "\n")
